<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: no cloud backup, no device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
