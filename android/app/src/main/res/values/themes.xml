<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the launch window matches whichever theme Compose is about to draw and
         there is no flash of the wrong background on a cold start. -->
    <style name="Theme.FamilyGroup" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
