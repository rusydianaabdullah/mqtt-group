    <string name="app_name">Family Group</string>
    <string name="app_tagline">Private group chat and location sharing over MQTT</string>
    <string name="channel_connection">Connection</string>
    <string name="notification_connection_text">Running in the background</string>
    <string name="channel_connection_description">Keeps the group connected so messages arrive while the app is closed.</string>
    <!-- About -->
    <string name="action_about">About</string>
    <string name="action_back">Back</string>
    <string name="about_version_format">Version %1$s</string>
    <string name="about_tagline">Chat and location for the people you choose, on a server you run. No accounts, and nothing we can read.</string>
    <string name="about_highlight_encrypted">End-to-end encrypted; the broker only moves sealed bytes</string>
    <string name="about_highlight_broker">Your own MQTT broker, one per group if you want</string>
    <string name="about_highlight_map">A shared map with history you can replay, off by default</string>
    <string name="about_highlight_noaccount">No accounts, no phone numbers, no server of ours</string>
    <string name="about_next_title">What this becomes next</string>
    <string name="about_next_body">This app is a working prototype of a private communicator for enterprise closed systems — a mining site, a plantation, a vessel, a plant, a construction project. Places where the network is your own, the outside internet is unreliable or deliberately absent, and messages and crew positions must never leave the operator\'s infrastructure.</string>
    <string name="about_contact_title">Building something like this?</string>
    <string name="about_contact_body">If you would like this adapted to your own operation, or want to talk it through, please get in touch.</string>
    <string name="action_visit_us">Contact us</string>
